# ─────────────────────────────────────
# Supabase
# ─────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# ─────────────────────────────────────
# Site
# ─────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_GA_ID=                  # Google Analytics Measurement ID (G-XXXXXXXXXX — get from analytics.google.com)

# ─────────────────────────────────────
# AI Providers
# ─────────────────────────────────────
GEMINI_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
DEFAULT_AI_MODEL=gemini-2.0-flash

# ─────────────────────────────────────
# Security
# ─────────────────────────────────────
# Used to encrypt stored AI provider API keys (AES-256-CBC).
# REQUIRED — if unset the code derives it from SUPABASE_SERVICE_ROLE_KEY.
# WARNING: if you set it later, previously encrypted keys become unreadable.
ENCRYPTION_KEY=                        # 32-char random string (e.g. openssl rand -hex 32 | head -c 32)

# ─────────────────────────────────────
# SEO Tools
# ─────────────────────────────────────
GOOGLE_PAGESPEED_API_KEY=          # Google PageSpeed Insights API (free — get from Google Cloud Console)
REWRITEAI_API_KEY=                 # RewriteAI API (https://rewriteai.com) — humanize + write
PLAGIARISMCHECK_API_KEY=           # PlagiarismCheck.org API — web-based plagiarism detection
COPYLEAKS_API_KEY=
DATAFORSEO_API_KEY=
DATAFORSEO_API_SECRET=

# ─────────────────────────────────────
# Email — Resend (https://resend.com)
# ─────────────────────────────────────
# Leave empty to use local-only mode.
# When configured, emails will be sent via Resend API.
# When empty, the system shows: "Email provider not configured"
RESEND_API_KEY=                          # Resend API key (free — 3K emails/month — get from resend.com)
ADMIN_EMAIL=                             # Admin email used for test-email delivery / notifications

# ─────────────────────────────────────
# Email — SMTP (alternative to Resend)
# ─────────────────────────────────────
# Leave empty to use local-only mode.
# When configured, emails will be sent via nodemailer + SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@adultpulse.co.uk

# ─────────────────────────────────────
# Cron / Scheduled Tasks
# ─────────────────────────────────────
CRON_SECRET=                          # Secret key for cron job authentication (generate a random string)

# ─────────────────────────────────────
# Payment Providers
# ─────────────────────────────────────
# Stripe (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=                    # sk_live_... or sk_test_... for payment verification

# PayPal (https://developer.paypal.com/dashboard/applications)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_SANDBOX=true                   # Set to false for live

# GoPayFast / PayFast Pakistan (https://gopayfast.com — hosted checkout)
GOPAYFAST_MERCHANT_ID=                # Merchant ID from GoPayFast dashboard
GOPAYFAST_STORE_ID=                   # Store ID from GoPayFast dashboard
GOPAYFAST_SECURED_KEY=                # Secret key for hash signing
GOPAYFAST_CURRENCY=PKR                # Default currency (PKR)
GOPAYFAST_MODE=sandbox                # "sandbox" or "production"

# GoFastPay (DOES NOT EXIST — domain redirects to unrelated company)
GFASTPAY_API_KEY=                     # NOT USED
GFASTPAY_MERCHANT_ID=                 # NOT USED

# JazzCash (requires Pakistani merchant account)
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=

# EasyPaisa (requires Pakistani merchant account)
EASYPAISA_MERCHANT_ID=
EASYPAISA_PASSWORD=
